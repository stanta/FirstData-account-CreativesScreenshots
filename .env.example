# Copy to your shell/session; do not commit real tokens.
REPORTS_AD_TELEGRAM_TOKEN=123456:replace-with-real-token

# Optional runtime tuning.
REPORTS_AD_HEADLESS=1
REPORTS_AD_ALLOW_LOCAL_URLS=0
REPORTS_AD_ALLOW_LOCAL_CREATIVE_PATH=0
REPORTS_AD_VIEWPORT_WIDTH=1365
REPORTS_AD_VIEWPORT_HEIGHT=768
REPORTS_AD_MAX_CREATIVE_BYTES=10485760
REPORTS_AD_MAX_CREATIVE_PIXELS=20000000
REPORTS_AD_MAX_SCREENSHOT_BYTES=10485760
REPORTS_AD_MAX_SCREENSHOT_PIXELS=30000000
REPORTS_AD_REQUEST_TIMEOUT_SECONDS=300
REPORTS_AD_PAGE_LOAD_TIMEOUT_MS=12000
REPORTS_AD_CLICK_TIMEOUT_MS=7000
REPORTS_AD_SCREENSHOT_TIMEOUT_MS=15000
REPORTS_AD_TIMEOUT_DIAGNOSTICS=1
REPORTS_AD_TIMEOUT_DIAGNOSTICS_TIMEOUT_MS=5000
REPORTS_AD_LOCALE=ru-RU
REPORTS_AD_TIMEZONE=Europe/Moscow

# OCR/OpenAI-compatible vision endpoint. Keep credentials out of git.
# Public env naming follows validator-ai OCR_LLM_* even when the backing model is Gemma.
OCR_LLM_BASE_URL=http://gemma.firstdata.io/v1
OCR_LLM_MODEL=cyankiwi/gemma-4-26B-A4B-it-AWQ-4bit
OCR_LLM_TIMEOUT_SECONDS=20
OCR_LLM_MAX_RETRIES=5
OCR_LLM_CONFIDENCE_THRESHOLD=0.45
REPORTS_AD_OCR_IMAGE_MAX_WIDTH=1280
REPORTS_AD_OCR_IMAGE_MAX_PIXELS=2000000
# Opt-in OCR prompt/model-response diagnostics. Keeps image bytes/base64 and auth headers out of logs.
# REPORTS_AD_OCR_LOG_TEXT=1 enables prompt_text/response_text logging for banner_bbox,
# landing_bbox, and composition_validation. Default 0 disables text and keeps hashes/lengths only.
# REPORTS_AD_OCR_LOG_TEXT_MAX_CHARS=0 means unlimited sanitized text; set a positive value to truncate.
REPORTS_AD_OCR_LOG_TEXT=1
REPORTS_AD_OCR_LOG_TEXT_MAX_CHARS=0
# Optional explicit Authorization header wins over USER/PASSWORD if set.
# OCR_LLM_HEADER_AUTHORISATION=Basic replace-with-ocr-auth-header
# OCR_LLM_USER=replace-with-ocr-username
# OCR_LLM_PASSWORD=replace-with-ocr-password
# OCR_LLM_API_KEY=replace-for-gemini-ocr-if-needed

# Live Telegram E2E tests are opt-in and should use dedicated test credentials.
# TELEGRAM_E2E=1
# TELEGRAM_API_ID=replace-with-telegram-api-id
# TELEGRAM_API_HASH=replace-with-telegram-api-hash
# TELEGRAM_SESSION_STRING=replace-with-kurigram-string-session
# TELEGRAM_BOT_USERNAME=@replace_with_dedicated_test_bot
# TELEGRAM_E2E_TIMEOUT=180
# TELEGRAM_E2E_ARTIFACT_DIR=tmp/telegram-e2e-artifacts
# TELEGRAM_E2E_CLEANUP=1
