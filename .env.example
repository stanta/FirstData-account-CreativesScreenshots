# Optional runtime tuning.
REPORTS_AD_HEADLESS=1
REPORTS_AD_ALLOW_LOCAL_URLS=0
REPORTS_AD_ALLOW_LOCAL_CREATIVE_PATH=0
REPORTS_AD_VIEWPORT_WIDTH=1365
REPORTS_AD_VIEWPORT_HEIGHT=768
REPORTS_AD_MAX_CREATIVE_BYTES=10485760
REPORTS_AD_REQUEST_TIMEOUT_SECONDS=90
REPORTS_AD_TIMEOUT_DIAGNOSTICS=1
REPORTS_AD_TIMEOUT_DIAGNOSTICS_TIMEOUT_MS=5000
