# Copy to your shell/session; do not commit real tokens.
REPORTS_AD_TELEGRAM_TOKEN=123456:replace-with-real-token

# Optional runtime tuning.
REPORTS_AD_HEADLESS=1
REPORTS_AD_ALLOW_LOCAL_URLS=0
REPORTS_AD_ALLOW_LOCAL_CREATIVE_PATH=0
REPORTS_AD_VIEWPORT_WIDTH=1365
REPORTS_AD_VIEWPORT_HEIGHT=768
REPORTS_AD_MAX_CREATIVE_BYTES=10485760
REPORTS_AD_MAX_CREATIVE_PIXELS=20000000
REPORTS_AD_MAX_SCREENSHOT_BYTES=10485760
REPORTS_AD_MAX_SCREENSHOT_PIXELS=30000000
REPORTS_AD_REQUEST_TIMEOUT_SECONDS=300
REPORTS_AD_PAGE_LOAD_TIMEOUT_MS=12000
REPORTS_AD_CLICK_TIMEOUT_MS=7000
REPORTS_AD_SCREENSHOT_TIMEOUT_MS=15000
REPORTS_AD_TIMEOUT_DIAGNOSTICS=1
REPORTS_AD_TIMEOUT_DIAGNOSTICS_TIMEOUT_MS=5000
REPORTS_AD_LOCALE=ru-RU
REPORTS_AD_TIMEZONE=Europe/Moscow

# OCR/OpenAI-compatible vision endpoint. Keep credentials out of git.
# Public env naming follows validator-ai OCR_LLM_* even when the backing model is Gemma.
REPORTS_AD_OCR_LLM_BASE_URL=http://gemma.firstdata.io/v1
REPORTS_AD_OCR_LLM_MODEL=cyankiwi/gemma-4-26B-A4B-it-AWQ-4bit
REPORTS_AD_OCR_LLM_TIMEOUT_SECONDS=20
REPORTS_AD_OCR_LLM_MAX_RETRIES=5
REPORTS_AD_OCR_LLM_CONFIDENCE_THRESHOLD=0.45
# Optional explicit Authorization header wins over USER/PASSWORD if set.
# REPORTS_AD_OCR_LLM_HEADER_AUTHORISATION=Basic replace-with-ocr-auth-header
# REPORTS_AD_OCR_LLM_USER=replace-with-ocr-username
# REPORTS_AD_OCR_LLM_PASSWORD=replace-with-ocr-password
# REPORTS_AD_OCR_LLM_API_KEY=replace-for-gemini-ocr-if-needed
